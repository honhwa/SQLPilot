<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../../assets/sqlpilot.ico</ApplicationIcon>
    <AssemblyName>SqlPilotSetup</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ProductInfo.cs" Link="ProductInfo.cs" />
    <Compile Include="../Shared/Design.cs" Link="Design.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <EmbeddedResource Include="../../artifacts/installer-payload.zip" LogicalName="SqlPilot.Payload.zip" />
  </ItemGroup>
</Project>
